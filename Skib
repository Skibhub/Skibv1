local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Đường dẫn chính xác đến khu vực Summon lấy từ bảng quét
local summonArea = workspace:FindFirstChild("InteractZones") and workspace.InteractZones:FindFirstChild("Summon")

if summonArea then
    local targetCFrame = summonArea:IsA("Model") and summonArea:GetPrimaryPartCFrame() or summonArea.CFrame
    
    local distance = (RootPart.Position - targetCFrame.Position).Magnitude
    local speed = 150 
    local timeToTravel = distance / speed

    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(RootPart, tweenInfo, {CFrame = targetCFrame + Vector3.new(0, 3, 0)})
    
    tween:Play()
    print("Đang bay đến khu vực Summon...")

    tween.Completed:Wait()
    task.wait(0.5) 
    
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(0.1)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
    
    print("Đã đến khu vực Summon và bấm phím E thành công!")
else
    print("Không tìm thấy khu vực Summon trong InteractZones!")
end
